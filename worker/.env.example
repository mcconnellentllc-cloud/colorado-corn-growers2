# CCGA Board Vote Portal — required Worker secrets.
#
# This file documents the NAMES only. Do not put real values here and do not
# commit real values anywhere. Set each one with:
#
#   wrangler secret put RESEND_API_KEY
#   wrangler secret put SESSION_SECRET
#
# Wrangler prompts for the value and stores it encrypted with the Worker. The
# secrets are never written to wrangler.toml and never reach this repository.

# Resend API key for transactional email. Create at https://resend.com/api-keys
# with "Sending access" only, scoped to the verified cologrowers.com domain.
RESEND_API_KEY=re_replace_me

# Random 32+ byte string used to HMAC-sign session cookies. Generate with:
#   openssl rand -base64 48
SESSION_SECRET=replace_me_with_openssl_rand_base64_48
