# Copy to .env for local dev (never commit the real .env).
PORT=3000
# Must be long & random in production. On Render, let it generate one.
SESSION_SECRET=change-me-to-something-long-and-random
# This server's public URL. Render provides one; set it so links are correct.
PUBLIC_ORIGIN=http://localhost:3000
# Where the SQLite file lives. On Render, point this at the mounted disk.
DB_PATH=./data/board.db
# Email (Resend). Leave RESEND_API_KEY empty in dev to log links to the console.
RESEND_API_KEY=
MAIL_FROM=CCGA Board <board@cologrowers.com>
MAIL_REPLY_TO=
# First-run convenience: seed one admin so you can sign in on a fresh deploy.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
# Local http testing only — lets the browser send the cookie over http.
# NEVER set this in production.
COOKIE_SECURE=true
